
#window-decoration = none
#window-padding-x = 0
#window-padding-y = 0
background-opacity = 0.95
background-blur = macos-glass-regular
title = " "
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
window-save-state = always
bell-features = no-attention,no-title
confirm-close-surface = false
macos-shortcuts = deny
drag-handle = never
clipboard-trim-trailing-spaces = true

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# tmux: send prefix Ctrl+Y (\x19), then the command key (see tmux.conf)
keybind = cmd+t=text:\x19c
keybind = cmd+d=text:\x19-
keybind = cmd+shift+d=text:\x19|
keybind = cmd+w=text:\x19x
# clear screen + tmux scrollback (Ghostty's clear_screen can't reach tmux history)
keybind = cmd+k=text:\x19k
# navigate tmux tabs
keybind = opt+left=unbind
keybind = opt+right=unbind
# unbind new window
keybind = cmd+n=unbind