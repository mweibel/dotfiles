{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "console_title_template": "{{ .UserName }}@{{ .HostName }}",
  "terminal_background": "p:background",
  "blocks": [
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:blue",
          "style": "plain",
          "options": {
            "style": "full"
          },
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "type": "git",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \uf126 {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Staging.Changed) (.Working.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }} ",
          "foreground": "#ffffff",
          "background": "#326ce5"
        },
        {
          "type": "kubectl",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \u2388 {{ .Context }}{{ if .Namespace }} :: {{ .Namespace }}{{ end }} ",
          "cache": {
            "duration": "1m",
            "strategy": "session"
          },
          "foreground": "#ffffff",
          "background": "#326CE5",
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "\ue0b0"
        },
        {
          "type": "text",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \u276f ",
          "foreground": "#ffffff"
        }
      ],
      "type": "prompt"
    }
  ],
  "palette": {
    "black": "#282c34",
    "red": "#e06c75",
    "green": "#98c379",
    "yellow": "#e5c07b",
    "blue": "#61afef",
    "magenta": "#c678dd",
    "cyan": "#56b6c2",
    "white": "#dcdfe4",
    "foreground": "#dcdfe4",
    "background": "#282c34"
  }
}